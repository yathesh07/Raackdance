# Public (safe for the browser). Leave Supabase vars empty to run in DEMO mode
# (content from src/content, admin data stored in the browser's localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public). Secret goes in Supabase function secrets.
VITE_TURNSTILE_SITE_KEY=
VITE_SITE_URL=https://raackdance.com
# Set to "false" in production to disable the demo login entirely.
VITE_ALLOW_DEMO=true
VITE_MAP_TILES_URL=
VITE_MAP_TILES_ATTRIBUTION=
